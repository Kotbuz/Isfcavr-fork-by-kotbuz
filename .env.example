# =============================================================================
# Корневой .env — API, Docker Compose, Telegram-бот
# Скопируйте: cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
# Docker: DB_HOST задаётся в docker-compose (сервис "db").
# Локальный API + БД в контейнере: DB_HOST=localhost, DB_PORT=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=reviews_db
DB_USER=admin_user
DB_PASSWORD=YOUR_STRONG_PASSWORD

# Опционально: полная строка (в Docker задаётся автоматически для api)
# DATABASE_URL=postgresql://admin_user:YOUR_STRONG_PASSWORD@localhost:5433/reviews_db

# --- API (для бота и фронтенда в Docker) ---
# Локально: http://localhost:8000
# Внутри docker-compose сети бот использует http://api:8000 (переопределяется в compose)
API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Telegram-бот (опционально, сервис bot в docker-compose) ---
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=my_reviews_bot
