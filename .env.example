# Локальный запуск без Docker: DB_HOST=localhost, DB_PORT=5433 (порт из docker-compose)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KotbuzBot
INTERNAL_BOT_SECRET=
# Только если VPN даёт SOCKS/HTTP на ПК (Clash, v2rayN). Не ссылка t.me/proxy!
# TELEGRAM_PROXY_URL=socks5://host.docker.internal:1080
TELEGRAM_PROXY_URL=

# Frontend (Vite) — URL API с браузера
VITE_API_BASE_URL=http://localhost:8000

# Backend — ссылка в кнопке Telegram-уведомления
PUBLIC_FRONTEND_URL=http://localhost:5173
